# Conventional commits: type(scope)?: subject
first_line=$(head -n1 "$1")
if ! echo "$first_line" | grep -Eq '^(feat|fix|test|chore|docs|refactor|perf|ci|build|style|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo "✘ Commit message must follow Conventional Commits, e.g. 'feat(backend): add products endpoint'"
  exit 1
fi
