              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"quantity\": 1,\n  \"shipping\": {\n    \"address\": \"Calle 1 # 2-3\",\n    \"city\": \"Bogotá\",\n    \"region\": \"Cundinamarca\",\n    \"postalCode\": \"110111\"\n  },\n  \"card\": {\n    \"number\": \"4242424242424242\",\n    \"cvc\": \"123\",\n    \"expMonth\": \"12\",\n    \"expYear\": \"29\",\n    \"holderName\": \"Ana Perez\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "const b = pm.response.json();",
                  "if (b.id) pm.collectionVariables.set('transactionId', b.id);",
                  "if (b.delivery) pm.collectionVariables.set('deliveryId', b.delivery.id);",
                  "pm.test('APPROVED o PENDING', () => pm.expect(pm.response.json().status).to.be.oneOf(['APPROVED','PENDING']));"
                ]
              }
            }
          ]
        },
