{
  "name": "checkout-monorepo",
  "private": true,
  "description": "Mobile checkout with a sandbox payment gateway (NestJS + React)",
  "scripts": {
    "prepare": "husky",
    "verify": "scripts/verify.sh",
    "trace": "tsx scripts/trace.ts",
    "e2e": "npm --prefix frontend run e2e --",
    "e2e:headed": "npm --prefix frontend run e2e:headed --",
    "e2e:ui": "npm --prefix frontend run e2e:ui --",
    "e2e:report": "npm --prefix frontend run e2e:report --",
    "e2e:install": "npm --prefix frontend run e2e:install --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
